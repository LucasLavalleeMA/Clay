<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<Package
	  Name="Clay"
	  Manufacturer="Clay"
	  Version="$(var.ProductVersion)"
	  UpgradeCode="A6A790F8-116B-4A6F-88E5-52A4A14D0A2D"
	  Scope="perMachine"
	  InstallerVersion="500"
	  Compressed="yes">

		<MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
		<MediaTemplate EmbedCab="yes" />

		<!-- Targets the true 64-bit C:\Program Files directory -->
		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="Clay" />
		</StandardDirectory>

		<StandardDirectory Id="ProgramMenuFolder">
			<Directory Id="ApplicationProgramsFolder" Name="Clay" />
		</StandardDirectory>

		<StandardDirectory Id="DesktopFolder">
			<Component Id="DesktopShortcutComponent" Guid="D640C78A-3A4A-462E-99D4-526359F141CC">
				<Shortcut
				  Id="DesktopShortcut"
				  Name="Clay"
				  Description="Clay calculator"
				  Target="[INSTALLFOLDER]Clay.exe"
				  WorkingDirectory="INSTALLFOLDER" />
				<RegistryValue Root="HKCU" Key="Software\Clay" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
			</Component>
		</StandardDirectory>

		<DirectoryRef Id="ApplicationProgramsFolder">
			<Component Id="StartMenuShortcutComponent" Guid="3D2A440A-F8AA-4386-8DAA-BABEBF52D7EA">
				<Shortcut
				  Id="StartMenuShortcut"
				  Name="Clay"
				  Description="Clay calculator"
				  Target="[INSTALLFOLDER]Clay.exe"
				  WorkingDirectory="INSTALLFOLDER" />
				<RemoveFolder On="uninstall" />
				<RegistryValue Root="HKCU" Key="Software\Clay" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
			</Component>
		</DirectoryRef>

		<Feature Id="MainFeature" Title="Clay" Level="1">
			<ComponentGroupRef Id="AppFiles" />
			<ComponentRef Id="StartMenuShortcutComponent" />
			<ComponentRef Id="DesktopShortcutComponent" />
		</Feature>
	</Package>
</Wix>
