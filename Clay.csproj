<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <RootNamespace>Clay</RootNamespace>
        <AssemblyName>Clay</AssemblyName>
        <Version>1.0.1</Version>
        <AssemblyVersion>1.0.1.0</AssemblyVersion>
        <FileVersion>1.0.1.0</FileVersion>
        <InformationalVersion>1.0.1</InformationalVersion>
        <ApplicationIcon>Icon\icon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Platforms>x86;x64;ARM64</Platforms>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <UseWinUI>true</UseWinUI>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
	  <DefaultItemExcludes>$(DefaultItemExcludes);Dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
	    <None Remove="Directory.Build.props" />
        <Content Include="Icon\icon.ico" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Icon\icon512.png" CopyToOutputDirectory="PreserveNewest" />
        <None Include=".github\workflows\release.yml" />
        <None Include="Installer\Clay.Bundle.wixproj" />
        <None Include="Installer\Clay.Installer.wixproj" />
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

</Project>
