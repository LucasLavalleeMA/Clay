<Project>
  <PropertyGroup>
    <VersionPrefix>1.0.1</VersionPrefix>
    <!-- <VersionSuffix>beta.1</VersionSuffix> -->
    <!-- MSI/bundle versions must be numeric (no suffix). Still overridable with -p:ProductVersion=... -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">$(VersionPrefix)</ProductVersion>
  </PropertyGroup>
</Project>