<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clay.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clay">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="LayoutRoot">
        <Grid.Resources>
            <Style x:Key="ResultText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="ErrorText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="Opacity" Value="0.85" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleBarDragRegion" Grid.Column="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="Icon/icon512.png" Width="18" Height="18" Stretch="Uniform" />
                    <TextBlock x:Name="TitleText" Text="Clay" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <ToggleButton x:Name="PinButton" Grid.Column="1"
                          Width="46" Height="40" Padding="0"
                          BorderThickness="0" CornerRadius="0"
                          Background="Transparent"
                          ToolTipService.ToolTip="Keep on top"
                          Click="OnPinToggle">
                <FontIcon x:Name="PinIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Glyph="&#xE718;" />
            </ToggleButton>
        </Grid>

        <!-- Commands -->
        <CommandBar Grid.Row="1" Background="Transparent" IsOpen="False"
            DefaultLabelPosition="Right" HorizontalAlignment="Left" Margin="4,0,0,4">
            <AppBarButton Icon="OpenFile" Label="Open" Click="OnOpen"
                  KeyboardAcceleratorPlacementMode="Hidden">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Icon="Save" Label="Save" Click="OnSave"
                  KeyboardAcceleratorPlacementMode="Hidden">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Label="Save as" Click="OnSaveAs" KeyboardAcceleratorPlacementMode="Hidden">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Icon="Copy" Label="Copy results" Click="OnCopyResults" />
            <AppBarButton Icon="Delete" Label="Clear" Click="OnClear" />
            <AppBarSeparator />
            <AppBarButton Icon="Setting" Label="Settings">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutSubItem Text="Decimal places">
                            <RadioMenuFlyoutItem x:Name="Decimals2" Text="2" Tag="2" GroupName="Decimals" Click="OnDecimals" />
                            <RadioMenuFlyoutItem x:Name="Decimals4" Text="4" Tag="4" GroupName="Decimals" Click="OnDecimals" />
                            <RadioMenuFlyoutItem x:Name="Decimals6" Text="6" Tag="6" GroupName="Decimals" Click="OnDecimals" IsChecked="True" />
                            <RadioMenuFlyoutItem x:Name="Decimals8" Text="8" Tag="8" GroupName="Decimals" Click="OnDecimals" />
                            <RadioMenuFlyoutItem x:Name="Decimals10" Text="10" Tag="10" GroupName="Decimals" Click="OnDecimals" />
                            <RadioMenuFlyoutItem x:Name="Decimals12" Text="12" Tag="12" GroupName="Decimals" Click="OnDecimals" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Angle Units">
                            <RadioMenuFlyoutItem x:Name="RadiansOption" Text="Radians" Tag="Rad" GroupName="AngleUnits" Click="OnRadians" IsChecked="True" />
                            <RadioMenuFlyoutItem x:Name="DegreesOption" Text="Degrees" Tag="Deg" GroupName="AngleUnits" Click="OnDegrees" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Uncertainty mode">
                            <RadioMenuFlyoutItem x:Name="IntervalModeGaussian" Text="Variance / Gaussian" Tag="1" GroupName="IntervalMode" Click="OnIntervalMode" IsChecked="True" />
                            <RadioMenuFlyoutItem x:Name="IntervalModeInterval" Text="Interval arithmetic" Tag="2" GroupName="IntervalMode" Click="OnIntervalMode" />
                        </MenuFlyoutSubItem>
                        <ToggleMenuFlyoutItem x:Name="GroupToggle" Text="Group digits (1,000)" IsChecked="True" Click="OnGroupDigits" />
                        <ToggleMenuFlyoutItem x:Name="PhysicsToggle" Text="Physics units (N, Hz, A, V, Ω)" Click="OnPhysicsUnits" />
                        <ToggleMenuFlyoutItem x:Name="IgnoreWhitespaceToggle" Text="Ignore spaces in numbers" Click="OnIgnoreWhitespace" />
                        <ToggleMenuFlyoutItem x:Name="AssumePositiveToggle" Text="Assume positive variables" Click="OnAssumePositive" />
                        <MenuFlyoutSubItem Text="Theme">
                            <RadioMenuFlyoutItem x:Name="DefaultTheme" Text="Match system" Tag="Default" GroupName="Theme" Click="OnTheme" IsChecked="True" />
                            <RadioMenuFlyoutItem x:Name="LightTheme" Text="Light" Tag="Light" GroupName="Theme" Click="OnTheme" />
                            <RadioMenuFlyoutItem x:Name="DarkTheme" Text="Dark" Tag="Dark" GroupName="Theme" Click="OnTheme" />
                            <RadioMenuFlyoutItem x:Name="StickyTheme" Text="Sticky note" Tag="Sticky" GroupName="Theme" Click="OnTheme" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Refresh exchange rates" Click="OnRefreshRates" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Help" Label="Cheat sheet" Click="OnHelp" />
        </CommandBar>

        <!-- Editor | results -->
        <Grid x:Name="ContentSurface" Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="3*" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ResultsColumn" Width="2*" MinWidth="140" />
            </Grid.ColumnDefinitions>
            <Border x:Name="StickyBackground" Grid.ColumnSpan="3" Background="#FFF9B7" Visibility="Collapsed" />

            <TextBox x:Name="Editor" Grid.Column="0"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     IsSpellCheckEnabled="False"
                     IsTextPredictionEnabled="False"
                     PlaceholderText="Type something like  20% of 150  or  $100 in EUR"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="17"
                     Padding="20,14,12,14"
                     BorderThickness="0"
                     CornerRadius="0"
                     Background="Transparent"
                     VerticalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     TextChanged="OnTextChanged">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor"
                 Color="#0078D4" />
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColorWhenNotFocused"
                 Color="#6699CC" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>

            <ContentControl x:Name="PaneSplitter" Grid.Column="1" Width="6"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            IsTabStop="True" UseSystemFocusVisuals="True"
                            AutomationProperties.Name="Resize editor and results panes"
                            PointerPressed="OnSplitterPressed"
                            PointerMoved="OnSplitterMoved"
                            PointerReleased="OnSplitterReleased"
                            PointerCaptureLost="OnSplitterCaptureLost"
                            KeyDown="OnSplitterKeyDown"
                            ToolTipService.ToolTip="Drag or use Left/Right arrows to resize">
                <Border Background="Transparent" />
            </ContentControl>

            <!-- Scrolled in lock-step with the editor from code-behind -->
            <ScrollViewer x:Name="ResultsScroll" Grid.Column="2"
                          VerticalScrollMode="Disabled"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PointerWheelChanged="OnResultsWheel">
                <StackPanel x:Name="ResultsPanel" Margin="12,14,20,14" />
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="12,4"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" />
    </Grid>
</Window>
